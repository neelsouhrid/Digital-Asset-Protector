# ─────────────────────────────────────────────────────────────────────────────
# Digital Asset Protector — Blockchain Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Wallet ───────────────────────────────────────────────────────────────────
# Deployer wallet private key (without 0x prefix)
# Get test MATIC from: https://faucet.polygon.technology/
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# ── RPC Endpoints ────────────────────────────────────────────────────────────
# Polygon Amoy Testnet (default public RPC is pre-set in hardhat.config.js)
# Use Alchemy/Infura for production-grade reliability:
#   https://www.alchemy.com/  |  https://www.infura.io/
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/

# Polygon Mainnet (production)
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com/

# ── Polygonscan API Key ───────────────────────────────────────────────────────
# Required for contract verification on Polygonscan
# Get one free at: https://polygonscan.com/register
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────
# Set to "true" to enable gas cost reporting during tests
REPORT_GAS=false

# CoinMarketCap API key (used by hardhat-gas-reporter for USD estimates)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
