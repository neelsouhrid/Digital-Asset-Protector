<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Status bar at top -->
    <LinearLayout
        android:id="@+id/mapStatusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@drawable/gradient_bg"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/ic_dialog_map"
            app:tint="@color/white"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sighting Heatmap"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>

        <TextView
            android:id="@+id/tvLocationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Locating..."
            android:textColor="@color/golden"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- OpenStreetMap view -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/mapStatusBar"
        app:layout_constraintBottom_toTopOf="@id/mapInfoCard"/>

    <!-- Info card at bottom -->
    <androidx.cardview.widget.CardView
        android:id="@+id/mapInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="96dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCellInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📡 Scanning cell towers..."
                android:textSize="13sp"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/tvApproxLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Approximate location: Calculating..."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Location is approximate (±500m–2km). No precise GPS used."
                android:textSize="11sp"
                android:textColor="@color/status_pending"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
